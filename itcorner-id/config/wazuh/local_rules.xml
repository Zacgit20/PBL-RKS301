<!-- ==========================================================================
     ATURAN DETEKSI KUSTOM WAZUH SIEM - ITCORNER.ID (PBL-RKS301)
     Penanggung Jawab: Nur Arsyika Juana (SOC Analyst) & Afry Zacky (DevSecOps)
     Lokasi Target: /var/ossec/etc/rules/local_rules.xml pada Wazuh Manager (10.10.40.2)
     ========================================================================== -->

<group name="itcorner,soc,web,waf,">

  <!-- 1. Deteksi Serangan Web (SQLi / XSS) yang Diblokir WAF ModSecurity di Web Server DMZ (10.10.10.2) -->
  <rule id="100101" level="10">
    <decoded_as>json</decoded_as>
    <field name="transaction.messages.details.ruleId">^942|^941</field>
    <description>ITCorner SOC: Serangan SQL Injection atau XSS Terdeteksi oleh WAF ModSecurity pada Web Server DMZ (10.10.10.2)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- 2. Deteksi Brute-Force Login Aplikasi Web ITCorner.id (HTTP 401/429 Berulang) -->
  <rule id="100102" level="10" frequency="5" timeframe="60">
    <if_matched_sid>31101</if_matched_sid>
    <url>/auth/login</url>
    <description>ITCorner SOC: Indikasi Brute-Force Login pada Akun E-Commerce ITCorner.id</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- 3. Deteksi SSH Brute-Force pada Web/App Server DMZ (10.10.10.2) -->
  <rule id="100103" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5716</if_matched_sid>
    <hostname>itcorner-web|10.10.10.2</hostname>
    <description>ITCorner SOC: Serangan SSH Brute-Force Kritis pada Web/App Server DMZ (10.10.10.2)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- 4. Deteksi Akses Ilegal Berulang ke Endpoint Dashboard Admin (HTTP 403 Forbidden) -->
  <rule id="100104" level="8" frequency="4" timeframe="60">
    <if_matched_sid>31108</if_matched_sid>
    <url>^/admin</url>
    <description>ITCorner SOC: Percobaan Akses Ilegal Berulang ke Dashboard Administrator (HTTP 403 Forbidden)</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>

  <!-- 5. Deteksi Percobaan Manipulasi / Penghapusan Snapshot Backup Restic (Append-Only Violation) -->
  <rule id="100105" level="12">
    <decoded_as>json</decoded_as>
    <match>DELETE|append-only mode violation</match>
    <description>ITCorner SOC: Pelanggaran Kritis! Percobaan Penghapusan Snapshot Restic Ditolak oleh Backup Server (10.10.30.3)</description>
    <mitre>
      <id>T1485</id>
    </mitre>
  </rule>

</group>
