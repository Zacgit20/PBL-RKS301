# ============================================================================
# ATURAN DETEKSI KUSTOM SURICATA IDS/IPS - ITCORNER.ID (PBL-RKS301)
# Dipasang pada: Edge Router (10.10.1.1) & Internal Router (10.10.1.2)
# ============================================================================

# 1. Deteksi Nmap SYN Port Scanning menuju Web/App Server DMZ (10.10.10.2)
alert tcp any any -> 10.10.10.2 any (msg:"ITCORNER-IDS Possible Nmap SYN Scan to DMZ Web Server"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000001; rev:1;)

# 2. Deteksi SSH Brute-Force menuju Bastion Host DMZ (10.10.10.3)
alert tcp any any -> 10.10.10.3 22 (msg:"ITCORNER-IDS Potential SSH Brute-Force on Bastion Host"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# 3. Deteksi Percobaan Akses Ilegal ke Port PostgreSQL (5432) selain dari Web Server (10.10.10.2)
alert tcp !10.10.10.2 any -> 10.10.30.2 5432 (msg:"ITCORNER-IDS Unauthorized Direct Database Access Attempt"; flags:S; sid:1000003; rev:1;)

# 4. Deteksi Serangan SQL Injection pada URI HTTP menuju Web Server DMZ
alert http any any -> 10.10.10.2 any (msg:"ITCORNER-IDS SQL Injection Attempt in HTTP URI"; flow:established,to_server; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; sid:1000004; rev:1;)